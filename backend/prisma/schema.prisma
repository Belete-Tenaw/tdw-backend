generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model JobSeeker {
  id                   String                @id @default(uuid())
  fullName             String
  gender               Gender
  age                  Int
  religion             String?
  maritalStatus        MaritalStatus
  phone                String?               @unique
  email                String?               @unique
  password             String
  bio                  String?
  skills               String[]
  languages            String[]              @default([])
  experienceYears      Int
  expectedSalary       Int
  preferredLocation    String
  preferredArrangement PreferredArrangement
  profilePhoto         String
  certificates         String[]              @default([])
  idDocument           String?
  isVerified           Boolean               @default(false)
  verificationStatus   VerificationStatus    @default(NOT_STARTED)
  rating               Float                 @default(0.0)
  completedJobs        Int                   @default(0)
  locationRegion       String?
  locationZone         String?
  locationWoreda       String?
  locationKebele       String?
  subscriptionExpiry   DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  badge                String?               @default("STANDARD")
  faydaId              String?               @unique
  featuredExpiry       DateTime?
  guarantorIdUrl          String?
  guarantorPhone          String?
  guarantorName           String?
  guarantorRelationship   String?
  isGuarantorVerified     Boolean               @default(false)
  guarantorVerifiedAt     DateTime?
  guarantorToken          String?
  guarantorOtp            String?
  guarantorOtpExpires     DateTime?
  healthCertificateUrl    String?
  isActive             Boolean               @default(true)
  isFaydaVerified      Boolean               @default(false)
  isFeatured           Boolean               @default(false)
  nationalIdUrl        String?
  passwordHint         String?
  policeClearanceUrl   String?
  priorityWeight       Int                   @default(0)
  referralCode         String?               @unique
  referralCount        Int                   @default(0)
  rewardPoints         Int                   @default(0)
  referredById         String?
  referredByType       String?
  securityAnswer       String?
  securityQuestion     String?
  telegramChatId       String?               @unique
  videoBio             String?
  videoTranscription   Json?
  interviewAnswers     Json?
  availability         Json?
  tier                 SeekerTier            @default(BRONZE)
  premiumCode          String?
  isSubscribed         Boolean               @default(false)
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  liveSelfieUrl        String?
  behaviorScore        Float                 @default(50.0)
  responseTimeMs       Int?
  fcmToken             String?               // FCM device token for push notifications
  auditLogs            AuditLog[]
  contracts            Contract[]
  disputes             Dispute[]             @relation("ReportedByJS")
  escrowContracts      EscrowContract[]
  receivedMessages     Message[]             @relation("ReceivedByJS")
  sentMessages         Message[]             @relation("SentByJS")
  payments             Payment[]
  reportsReceived      Report[]              @relation("JSReported")
  reportsSent          Report[]              @relation("JSReports")
  reviewsSent          Review[]              @relation("JSReviewsSent")
  reviewsReceived      Review[]              @relation("JSReviewsReceived")
  subscriptions        Subscription[]
  userTrainings        UserTraining[]
  verificationRequests VerificationRequest[]
  viewLogs             ViewLog[]
  notifications        Notification[]
  sosAlerts            SOSAlert[]
  diasporaAssignments  DiasporaJob[]

  @@index([tier])
  @@index([createdAt])
  @@index([isVerified])
  @@index([preferredLocation])
  @@index([experienceYears])
  @@index([expectedSalary])
  @@index([phone])
  @@index([isActive])
}

model Employer {
  id                   String                @id @default(uuid())
  employerType         EmployerType
  contactName          String
  phone                String?               @unique
  email                String?               @unique
  password             String
  address              String
  familySize           Int?
  profilePhoto         String?
  idDocument           String?
  certificates         String[]              @default([])
  isVerified           Boolean               @default(false)
  verificationStatus   VerificationStatus    @default(NOT_STARTED)
  rating               Float                 @default(0.0)
  completedJobs        Int                   @default(0)
  locationRegion       String?
  locationZone         String?
  locationWoreda       String?
  locationKebele       String?
  subscriptionExpiry   DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  badge                String?               @default("STANDARD")
  faydaId              String?               @unique
  isActive             Boolean               @default(true)
  isFaydaVerified      Boolean               @default(false)
  passwordHint         String?
  referralCode         String?               @unique
  referralCount        Int                   @default(0)
  rewardPoints         Int                   @default(0)
  referredById         String?
  referredByType       String?
  securityAnswer       String?
  securityQuestion     String?
  telegramChatId       String?               @unique
  tier                 EmployerTier          @default(FREE)
  premiumCode          String?
  isSubscribed         Boolean               @default(false)
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  liveSelfieUrl        String?
  behaviorScore        Float                 @default(50.0)
  responseTimeMs       Int?
  fcmToken             String?               // FCM device token for push notifications
  auditLogs            AuditLog[]
  contracts            Contract[]
  disputes             Dispute[]             @relation("ReportedByEmp")
  escrowContracts      EscrowContract[]
  hiringRequirement    HiringRequirement?
  jobPosts             JobPost[]
  receivedMessages     Message[]             @relation("ReceivedByEmp")
  sentMessages         Message[]             @relation("SentByEmp")
  payments             Payment[]
  reportsReceived      Report[]              @relation("EmpReported")
  reportsSent          Report[]              @relation("EmpReports")
  reviewsSent          Review[]              @relation("EmpReviewsSent")
  reviewsReceived      Review[]              @relation("EmpReviewsReceived")
  subscriptions        Subscription[]
  verificationRequests VerificationRequest[]
  viewLogs             ViewLog[]
  notifications        Notification[]
  sosAlerts            SOSAlert[]
  diasporaJobs         DiasporaJob[]

  @@index([tier])
  @@index([createdAt])
  @@index([phone])
  @@index([isActive])
}

model HiringRequirement {
  id           String   @id @default(uuid())
  employerId   String   @unique
  requirements Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employer     Employer @relation(fields: [employerId], references: [id])
}

model JobPost {
  id                   String               @id @default(uuid())
  employerId           String
  title                String
  description          String
  requiredSkills       String[]
  salaryOffered        Int
  jobType              String
  preferredArrangement PreferredArrangement
  address              String
  locationRegion       String?
  locationZone         String?
  locationWoreda       String?
  locationKebele       String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  contracts            Contract[]
  escrowContracts      EscrowContract[]
  employer             Employer             @relation(fields: [employerId], references: [id], onDelete: Cascade)
  viewLogs             ViewLog[]

  @@index([employerId])
  @@index([createdAt])
  @@index([jobType])
  @@index([preferredArrangement])
  @@index([salaryOffered])
  @@index([locationRegion])
}

model Message {
  id            String     @id @default(uuid())
  content       String
  timestamp     DateTime   @default(now())
  read          Boolean    @default(false)
  senderJSId    String?
  receiverJSId  String?
  senderEmpId   String?
  receiverEmpId String?
  receiverEmp   Employer?  @relation("ReceivedByEmp", fields: [receiverEmpId], references: [id])
  receiverJS    JobSeeker? @relation("ReceivedByJS", fields: [receiverJSId], references: [id])
  senderEmp     Employer?  @relation("SentByEmp", fields: [senderEmpId], references: [id])
  senderJS      JobSeeker? @relation("SentByJS", fields: [senderJSId], references: [id])

  @@index([senderJSId])
  @@index([receiverJSId])
  @@index([senderEmpId])
  @@index([receiverEmpId])
  @@index([senderJSId, receiverEmpId, timestamp])
  @@index([senderEmpId, receiverJSId, timestamp])
  @@index([timestamp])
}

model ViewLog {
  id                String     @id @default(uuid())
  createdAt         DateTime   @default(now())
  jobSeekerId       String?
  employerId        String?
  targetJobPostId   String?
  targetJobSeekerId String?
  employer          Employer?  @relation(fields: [employerId], references: [id])
  jobSeeker         JobSeeker? @relation(fields: [jobSeekerId], references: [id])
  targetJobPost     JobPost?   @relation(fields: [targetJobPostId], references: [id])

  @@index([createdAt])
  @@index([jobSeekerId, createdAt])
  @@index([employerId, createdAt])
}

model SubscriptionTier {
  id            String         @id @default(uuid())
  name          String         @unique
  priceETB      Float
  durationDays  Int
  features      String[]
  createdAt     DateTime       @default(now())
  tier          String
  period        String         @default("MONTHLY")
  subscriptions Subscription[]
}

model Subscription {
  id          String             @id @default(uuid())
  jobSeekerId String?
  employerId  String?
  tierId      String
  startDate   DateTime           @default(now())
  endDate     DateTime
  status      SubscriptionStatus @default(ACTIVE)
  paymentId   String?            @unique
  employer    Employer?          @relation(fields: [employerId], references: [id])
  jobSeeker   JobSeeker?         @relation(fields: [jobSeekerId], references: [id])
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  tier        SubscriptionTier   @relation(fields: [tierId], references: [id])
}

model Payment {
  id                   String          @id @default(uuid())
  amount               Float
  currency             String          @default("ETB")
  provider             PaymentProvider
  transactionReference String          @unique
  status               PaymentStatus   @default(PENDING)
  createdAt            DateTime        @default(now())
  jobSeekerId          String?
  employerId           String?
  tierId               String?
  invoice              Invoice?
  employer             Employer?       @relation(fields: [employerId], references: [id])
  jobSeeker            JobSeeker?      @relation(fields: [jobSeekerId], references: [id])
  subscription         Subscription?

  @@index([jobSeekerId])
  @@index([employerId])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  paymentId     String   @unique
  generatedAt   DateTime @default(now())
  pdfUrl        String?
  payment       Payment  @relation(fields: [paymentId], references: [id])
}

model SubscriptionCode {
  id           String             @id @default(uuid())
  code         String             @unique
  status       SubscriptionStatus @default(UNUSED)
  assignedTo   String?
  userType     String?
  durationDays Int                @default(30)
  createdAt    DateTime           @default(now())
  expiresAt    DateTime
  codeType     CodeType           @default(TIME_EXTENSION)
  tierUpgrade  EmployerTier?
}

model VerificationRequest {
  id          String             @id @default(uuid())
  jobSeekerId String?
  employerId  String?
  requestType String
  status      VerificationStatus @default(PENDING)
  adminNotes  String?
  submittedAt DateTime           @default(now())
  reviewedAt  DateTime?
  documents   Document[]
  employer    Employer?          @relation(fields: [employerId], references: [id])
  jobSeeker   JobSeeker?         @relation(fields: [jobSeekerId], references: [id])
}

model Document {
  id           String              @id @default(uuid())
  url          String
  documentType String
  uploadedAt   DateTime            @default(now())
  requestId    String
  request      VerificationRequest @relation(fields: [requestId], references: [id])
}

model Contract {
  id             String         @id @default(uuid())
  employerId     String
  jobSeekerId    String
  jobPostId      String?
  status         ContractStatus @default(DRAFT)
  startDate      DateTime
  endDate        DateTime?
  salary         Float
  insuranceFee   Float?         @default(0)
  employerSigned Boolean        @default(false)
  workerSigned   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  employer       Employer       @relation(fields: [employerId], references: [id])
  jobPost        JobPost?       @relation(fields: [jobPostId], references: [id])
  jobSeeker      JobSeeker      @relation(fields: [jobSeekerId], references: [id])
  terms          ContractTerm[]
  disputes       Dispute[]
  reviews        Review[]
  transitSessions TransitSession[]
  householdChecklist HouseholdChecklist?
  payrollSchedule   PayrollSchedule?

  @@index([employerId])
  @@index([jobSeekerId])
  @@index([status])
  @@index([createdAt])
}

model HouseholdChecklist {
  id                 String    @id @default(uuid())
  contractId         String    @unique
  contract           Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  items              Json      @default("[]")
  employerSigned     Boolean   @default(false)
  employerSignedAt   DateTime?
  workerSigned       Boolean   @default(false)
  workerSignedAt     DateTime?
  departureCleared   Boolean   @default(false)
  departureClearedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ContractTerm {
  id         String   @id @default(uuid())
  contractId String
  title      String
  content    String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Dispute {
  id            String        @id @default(uuid())
  contractId    String?
  reporterJSId  String?
  reporterEmpId String?
  reason        String
  description   String
  status        DisputeStatus @default(OPEN)
  resolution    String?
  adminId       String?
  evidenceUrls  String[]      @default([])
  createdAt     DateTime      @default(now())
  admin         Admin?        @relation(fields: [adminId], references: [id])
  contract      Contract?     @relation(fields: [contractId], references: [id])
  reporterEmp   Employer?     @relation("ReportedByEmp", fields: [reporterEmpId], references: [id])
  reporterJS    JobSeeker?    @relation("ReportedByJS", fields: [reporterJSId], references: [id])
}

model Report {
  id            String     @id @default(uuid())
  reporterJSId  String?
  reporterEmpId String?
  reportedJSId  String?
  reportedEmpId String?
  reason        String
  timestamp     DateTime   @default(now())
  reportedEmp   Employer?  @relation("EmpReported", fields: [reportedEmpId], references: [id])
  reportedJS    JobSeeker? @relation("JSReported", fields: [reportedJSId], references: [id])
  reporterEmp   Employer?  @relation("EmpReports", fields: [reporterEmpId], references: [id])
  reporterJS    JobSeeker? @relation("JSReports", fields: [reporterJSId], references: [id])
}

model Review {
  id            String     @id @default(uuid())
  rating        Int
  comment       String?
  createdAt     DateTime   @default(now())
  reviewerJSId  String?
  reviewerEmpId String?
  targetJSId    String?
  targetEmpId   String?
  contractId    String?
  contract      Contract?  @relation(fields: [contractId], references: [id])
  reviewerEmp   Employer?  @relation("EmpReviewsSent", fields: [reviewerEmpId], references: [id])
  reviewerJS    JobSeeker? @relation("JSReviewsSent", fields: [reviewerJSId], references: [id])
  targetEmp     Employer?  @relation("EmpReviewsReceived", fields: [targetEmpId], references: [id])
  targetJS      JobSeeker? @relation("JSReviewsReceived", fields: [targetJSId], references: [id])

  @@index([targetJSId])
  @@index([targetEmpId])
}

model Admin {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String
  role      AdminRole  @default(MODERATOR)
  fcmToken  String?                          // FCM device token for push notifications
  auditLogs AuditLog[]
  disputes  Dispute[]
}

model AuditLog {
  id          String     @id @default(uuid())
  action      String
  userId      String?
  userType    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime   @default(now())
  employerId  String?
  jobSeekerId String?
  adminId     String?
  employer    Employer?  @relation(fields: [employerId], references: [id])
  jobSeeker   JobSeeker? @relation(fields: [jobSeekerId], references: [id])
  admin       Admin?     @relation(fields: [adminId], references: [id])
}

model TrainingModule {
  id            String         @id @default(uuid())
  title         String
  description   String
  videoUrl      String?
  quizData      Json?
  category      String
  points        Int            @default(10)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userTrainings UserTraining[]
}

model UserTraining {
  id             String         @id @default(uuid())
  jobSeekerId    String
  moduleId       String
  score          Int            @default(0)
  completedAt    DateTime       @default(now())
  jobSeeker      JobSeeker      @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  trainingModule TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([jobSeekerId, moduleId])
}

model EscrowContract {
  id          String       @id @default(uuid())
  employerId  String
  workerId    String
  jobId       String?
  amount      Float
  status      EscrowStatus @default(PENDING)
  telebirrRef String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employer    Employer     @relation(fields: [employerId], references: [id])
  jobPost     JobPost?     @relation(fields: [jobId], references: [id])
  worker      JobSeeker    @relation(fields: [workerId], references: [id])
}

model TransitSession {
  id          String   @id @default(uuid())
  contractId  String
  userId      String
  latitude    Float
  longitude   Float
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  contract    Contract @relation(fields: [contractId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum PreferredArrangement {
  LIVE_IN
  LIVE_OUT
  PART_TIME
}

enum SeekerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum EmployerTier {
  FREE
  SILVER_ACCESS
  GOLD_ACCESS
  PLATINUM_ACCESS
}

enum EmployerType {
  HOUSEHOLD
  BUSINESS
}

enum SubscriptionStatus {
  PENDING
  UNUSED
  USED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CodeType {
  TIME_EXTENSION
  TRUST_UPGRADE
}

enum AdminRole {
  SUPERADMIN
  MODERATOR
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  TELEBIRR
  CHAPA
  CBE
  MANUAL
  STRIPE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_STARTED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  COMPLETED
  TERMINATED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum EscrowStatus {
  PENDING
  FUNDED
  RELEASED
  DISPUTED
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  userType    String   // 'JOB_SEEKER' or 'EMPLOYER'
  title       String
  message     String
  type        String   @default("SYSTEM") // 'MATCH', 'MESSAGE', 'PAYMENT', 'SYSTEM'
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  employer    Employer?  @relation(fields: [userId], references: [id], map: "Notification_Employer_fkey")
  jobSeeker   JobSeeker? @relation(fields: [userId], references: [id], map: "Notification_JobSeeker_fkey")

  @@index([userId, read])
}

model SOSAlert {
  id          String   @id @default(uuid())
  userId      String
  userType    String   // 'JOB_SEEKER' or 'EMPLOYER'
  latitude    Float?
  longitude   Float?
  status      String   @default("ACTIVE") // 'ACTIVE', 'RESOLVED'
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  employer    Employer?  @relation(fields: [userId], references: [id], map: "SOSAlert_Employer_fkey")
  jobSeeker   JobSeeker? @relation(fields: [userId], references: [id], map: "SOSAlert_JobSeeker_fkey")

  @@index([status])
  @@index([createdAt])
}

// ── Feature 3: Recurring Monthly Payroll & Auto-Split Remittance ──────────────

model PayrollSchedule {
  id                    String    @id @default(uuid())
  contractId            String    @unique
  contract              Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  grossSalaryEtb        Float
  workerAccountNumber   String    // Telebirr or CBE Birr
  workerAccountType     String    @default("TELEBIRR") // "TELEBIRR" | "CBE_BIRR"
  // Optional family split — voluntary
  familyAccountNumber   String?
  familyAccountType     String?   // "CBE" | "AWASH" | "ABYSSINIA"
  familySplitPercent    Float     @default(0) // 0-100, e.g. 15
  // Savings/insurance reserve
  savingsPercent        Float     @default(5)
  // Execution schedule
  dayOfMonth            Int       @default(25) // 25th of each month
  isActive              Boolean   @default(true)
  lastRunAt             DateTime?
  nextRunAt             DateTime
  // History
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  disbursements         PayrollDisbursement[]
}

model PayrollDisbursement {
  id                 String          @id @default(uuid())
  scheduleId         String
  schedule           PayrollSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  grossAmount        Float
  workerAmount       Float
  familyAmount       Float           @default(0)
  savingsAmount      Float           @default(0)
  platformFee        Float
  status             String          @default("PENDING") // "PENDING" | "PROCESSED" | "FAILED"
  workerRef          String?
  familyRef          String?
  failureReason      String?
  processedAt        DateTime?
  createdAt          DateTime        @default(now())
}

// ── Feature 4: Diaspora "Care for Parents Back Home" & Cross-Border Escrow ────

model DiasporaJob {
  id                  String    @id @default(uuid())
  employerId          String
  employer            Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title               String
  description         String
  // Parent / care recipient details
  parentName          String
  parentPhone         String
  parentLocationCity  String    @default("Addis Ababa")
  parentAddress       String
  // Financial — diaspora pays in foreign currency
  monthlyBudgetUsd    Float
  monthlyBudgetEtb    Float     // computed at 1 USD ≈ 130 ETB
  currency            String    @default("USD") // "USD" | "EUR" | "GBP" | "SAR" | "AED"
  // MOLS compliance vault
  molsMedicalCertUrl  String?
  molsYellowFeverUrl  String?
  molsPreDepartureUrl String?
  // Status
  status              String    @default("OPEN") // "OPEN" | "MATCHED" | "ACTIVE" | "CLOSED"
  assignedSeekerId    String?
  assignedSeeker      JobSeeker? @relation(fields: [assignedSeekerId], references: [id])
  contractId          String?   @unique
  stripePaymentIntentId String?
  stripeSponsorEmail  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([employerId])
}

